[Unit]
Description=Persistent agent brain (memory + router)
After=network.target

[Service]
Type=simple
User=root
Environment=BRAIN_HOST=127.0.0.1
Environment=BRAIN_PORT=18099
Environment=BRAIN_DB=/var/lib/brain/brain.db
EnvironmentFile=-/etc/brain.env
ExecStart=/usr/bin/python3 /opt/brain/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
