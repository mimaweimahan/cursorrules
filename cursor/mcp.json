{
    "mcpServers": {
        "figma": {
            "type": "http",
            "url": "https://mcp.figma.com/mcp"
        },
        "context7": {
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@upstash/context7-mcp"
            ]
        },
        "playwright": {
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@playwright/mcp@latest",
                "--cdp-endpoint=chrome"
            ]
        },
        "playwright-new": {
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@playwright/mcp@latest"
            ]
        },
        "github": {
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer REDACTED
            }
        },
        "codebase-memory-mcp": {
            "command": "C:/Users/mac/.local/bin/codebase-memory-mcp.exe",
            "args": [
                "--ui=false"
            ],
            "env": {
                "CBM_CACHE_DIR": "G:/xiangmu/.codebase-memory-mcp"
            }
        },
        "browser-tools": {
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@agentdeskai/browser-tools-mcp@1.2.0"
            ]
        },
        "runpod": {
            "type": "http",
            "url": "https://mcp.getrunpod.io/"
        },
        "runpod-docs": {
            "type": "http",
            "url": "https://docs.runpod.io/mcp"
        },
        "lmstudio": {
            "command": "cmd",
            "args": [
                "/c",
                "node",
                "G:\\lm\\lmstudio-mcp\\index.mjs"
            ]
        },
        "huggingface": {
            "type": "http",
            "url": "https://huggingface.co/mcp"
        }
    }
}
